# ============================================================================
# THEME & COLORS
# ============================================================================

# Color scheme for terminal
theme = "Catppuccin Macchiato"


# ============================================================================
# FONT
# ============================================================================

# Font with icon support
font-family = JetBrainsMonoNL Nerd Font
# Use real font variants (no synthetic bold/italic)
font-synthetic-style = false
# Font size in points
font-size = 14
# Disable ligatures (-> stays -> not ➜)
font-feature = -liga,-calt,-dlig


# ============================================================================
# CURSOR
# ============================================================================

# Block-shaped cursor
cursor-style = block
# Cursor blinks
cursor-style-blink = true
# Cursor uses cell's text color
cursor-color = cell-foreground
# Text under cursor uses background color (inverted)
cursor-text = cell-background
# Shell doesn't control cursor
shell-integration-features = no-cursor


# ============================================================================
# WINDOW
# ============================================================================

# Horizontal padding in pixels
window-padding-x = 8
# Vertical padding in pixels
window-padding-y = 8
# Distribute padding evenly
window-padding-balance = true
# Don't save window size/position
window-save-state = never
# Open new tabs next to current tab
window-new-tab-position = current
# Show macOS titlebar with traffic lights
window-decoration = true


# ============================================================================
# MACOS SPECIFIC
# ============================================================================

# Titlebar with tabs (uses theme background color for tab bar)
macos-titlebar-style = tabs
# Don't treat Option key as Alt
macos-option-as-alt = false


# ============================================================================
# QUICK TERMINAL
# ============================================================================

# Quick terminal in center of screen
quick-terminal-position = center
# No animations (instant open)
quick-terminal-animation-duration = 0
# Size: 70% width and height
quick-terminal-size = 70%,70%


# ============================================================================
# BEHAVIOR
# ============================================================================

# Hide mouse cursor while typing
mouse-hide-while-typing = true
# No confirmation when closing
confirm-close-surface = false
# Auto-copy selected text to clipboard
copy-on-select = clipboard
# No protection against accidental paste
clipboard-paste-protection = false
# Safe paste with brackets
clipboard-paste-bracketed-safe = true
# Check for updates
auto-update = check
# Use stable update channel
auto-update-channel = stable


# ============================================================================
# KEYBINDINGS - WINDOW & APP
# ============================================================================

# Reload configuration
keybind = super+r=reload_config
# Open new window
keybind = super+n=new_window
# Quit app
keybind = super+q=quit
# Close surface
keybind = super+w=close_surface
# Close window
keybind = super+shift+w=close_window
# Toggle fullscreen
keybind = super+ctrl+f=toggle_fullscreen


# ============================================================================
# KEYBINDINGS - TABS
# ============================================================================

# Create new tab
keybind = super+t=new_tab
# Switch to next tab
keybind = super+alt+right=next_tab
# Switch to previous tab
keybind = super+alt+left=previous_tab

# Jump directly to tab (1-9)
keybind = super+physical:one=goto_tab:1
keybind = super+physical:two=goto_tab:2
keybind = super+physical:three=goto_tab:3
keybind = super+physical:four=goto_tab:4
keybind = super+physical:five=goto_tab:5
keybind = super+physical:six=goto_tab:6
keybind = super+physical:seven=goto_tab:7
keybind = super+physical:eight=goto_tab:8
keybind = super+physical:nine=goto_tab:9


# ============================================================================
# KEYBINDINGS - SPLITS
# ============================================================================

# Create split to the right
keybind = super+d=new_split:right
# Create split below
keybind = super+shift+d=new_split:down
# Toggle split zoom/maximize
keybind = super+shift+enter=toggle_split_zoom

# Navigate between splits
keybind = super+ctrl+left=goto_split:left
keybind = super+ctrl+right=goto_split:right
keybind = super+ctrl+up=goto_split:top
keybind = super+ctrl+down=goto_split:bottom
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+l=goto_split:right
keybind = super+ctrl+k=goto_split:top
keybind = super+ctrl+j=goto_split:bottom

# Resize splits
keybind = super+ctrl+alt+left=resize_split:left,10
keybind = super+ctrl+alt+right=resize_split:right,10
keybind = super+ctrl+alt+up=resize_split:up,10
keybind = super+ctrl+alt+down=resize_split:down,10


# ============================================================================
# KEYBINDINGS - SCROLLING
# ============================================================================

# Scroll to top
keybind = super+home=scroll_to_top
# Scroll to bottom
keybind = super+end=scroll_to_bottom
# Scroll page up
keybind = super+page_up=scroll_page_up
# Scroll page down
keybind = super+page_down=scroll_page_down


# ============================================================================
# KEYBINDINGS - FONT SIZE
# ============================================================================

# Increase font size
keybind = super+plus=increase_font_size:1
keybind = super+equal=increase_font_size:1
# Decrease font size
keybind = super+minus=decrease_font_size:1
# Reset font size
keybind = super+zero=reset_font_size


# ============================================================================
# KEYBINDINGS - CLIPBOARD & EDITING
# ============================================================================

# Paste from clipboard
keybind = super+v=paste_from_clipboard
# Copy to clipboard
keybind = super+c=copy_to_clipboard
# Select all
keybind = super+a=select_all
# Clear screen
keybind = super+k=clear_screen
# Toggle command palette
keybind = super+p=toggle_command_palette
# Write screen file and open
keybind = super+f=write_screen_file:open


# ============================================================================
# KEYBINDINGS - TEXT SELECTION
# ============================================================================

# Extend selection with arrow keys
keybind = super+shift+left=adjust_selection:left
keybind = super+shift+right=adjust_selection:right
keybind = super+shift+up=adjust_selection:up
keybind = super+shift+down=adjust_selection:down

# Extend selection by page
keybind = super+shift+page_up=adjust_selection:page_up
keybind = super+shift+page_down=adjust_selection:page_down

# Extend selection to start/end
keybind = super+shift+home=adjust_selection:home
keybind = super+shift+end=adjust_selection:end
keybind = super+b=adjust_selection:beginning_of_line


# ============================================================================
# KEYBINDINGS - QUICK TERMINAL (GLOBAL)
# ============================================================================

# Toggle quick terminal (works everywhere)
keybind = global:super+#=toggle_quick_terminal

# ============================================================================
